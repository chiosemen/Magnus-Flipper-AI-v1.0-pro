# ============================================
# STRIPE CONFIGURATION
# ============================================
# Get these from your Stripe dashboard: https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_PRICE=price_your_pro_price_id_here
STRIPE_AGENCY_PRICE=price_your_agency_price_id_here

# ============================================
# APPLICATION URLS
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ============================================
# MOBILE APP CONFIGURATION
# ============================================
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ============================================
# WORKER / API CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379
WORKER_SECRET=your-worker-secret-here
LOG_LEVEL=info

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

