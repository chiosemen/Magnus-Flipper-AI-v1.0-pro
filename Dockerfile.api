# syntax=docker/dockerfile:1

############################
# Base image with corepack #
############################
FROM node:20-alpine AS base
WORKDIR /app
ENV NODE_ENV=production

# Enable corepack so pnpm works
RUN corepack enable

#########################
# Install dependencies  #
#########################
FROM base AS deps

# Copy workspace files
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./

# Copy all package.json files for proper dependency resolution
COPY packages/core/package.json ./packages/core/
COPY packages/shared/package.json ./packages/shared/
COPY packages/queue/package.json ./packages/queue/
COPY packages/api/package.json ./packages/api/
COPY apps/api/package.json ./apps/api/

# Install all deps (frozen lockfile for reproducibility)
RUN pnpm install --frozen-lockfile --prod=false

#########################
# Build packages & API  #
#########################
FROM deps AS build

# Copy source code
COPY packages/core ./packages/core
COPY packages/shared ./packages/shared
COPY packages/queue ./packages/queue
COPY packages/api ./packages/api
COPY apps/api ./apps/api

# Build shared packages first
RUN pnpm --filter @magnus-flipper-ai/core build
RUN pnpm --filter @magnus-flipper-ai/shared build
RUN pnpm --filter @magnus-flipper-ai/queue build

# Build API packages
RUN pnpm --filter @magnus-flipper-ai/api build
RUN pnpm --filter api build

#########################
# Production runtime    #
#########################
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages

# Copy built files from build stage
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/queue/dist ./packages/queue/dist
COPY --from=build /app/packages/api/dist ./packages/api/dist
COPY --from=build /app/apps/api/dist ./apps/api/dist

# Copy package.json files for runtime
COPY --from=build /app/packages/core/package.json ./packages/core/
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/queue/package.json ./packages/queue/
COPY --from=build /app/packages/api/package.json ./packages/api/
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/package.json ./
COPY --from=build /app/pnpm-workspace.yaml ./

# Re-run install in production mode to ensure proper linking
RUN corepack enable && pnpm install --prod --frozen-lockfile --offline || pnpm install --prod --frozen-lockfile

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 apiuser
USER apiuser

# Expose API port
EXPOSE 4000

# Environment variable for port (can be overridden)
ENV PORT=4000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD \
  node -e "fetch('http://localhost:${PORT}/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" || \
  wget --no-verbose --tries=1 --spider http://localhost:${PORT}/health || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the API (try apps/api first, fallback to packages/api)
CMD ["sh", "-c", "node apps/api/dist/index.js || node packages/api/dist/server.js"]
