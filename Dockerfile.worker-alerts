FROM node:20-slim

RUN apt-get update && apt-get install -y dumb-init && apt-get clean

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
COPY apps/worker-alerts ./apps/worker-alerts
COPY packages ./packages

RUN npm install -g pnpm
RUN pnpm install --frozen-lockfile && pnpm --filter worker-alerts build

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/worker-alerts/dist/index.js"]
