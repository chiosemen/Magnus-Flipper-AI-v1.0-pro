generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuardianIngestionRun {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  marketplace String
  startedAt   DateTime @map("started_at")
  endedAt     DateTime? @map("ended_at")
  status      String
  items       Int
  errorsCount Int      @map("errors_count")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([marketplace, startedAt])
  @@map("guardian_ingestion_runs")
}

model GuardianLatestSnapshot {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  marketplace String  @unique
  lastRunAt  DateTime @map("last_run_at")
  lastOkAt   DateTime? @map("last_ok_at")
  lastError  Json?    @map("last_error")
  lagSeconds Int      @map("lag_seconds")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("guardian_latest_snapshots")
}

model GuardianInvariantResult {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  ok         Boolean
  violations Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("guardian_invariant_results")
}

model GuardianCanaryResult {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  ok        Boolean
  results   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("guardian_canary_results")
}

model GuardianAlert {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  severity  String
  category  String
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  context   Json?

  @@index([createdAt])
  @@map("guardian_alerts")
}
