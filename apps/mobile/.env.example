# Magnus Flipper AI Mobile - Environment Variables
# Copy this file to .env for local development

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=ws://localhost:4000/socket

# Push Notifications
EXPO_PUBLIC_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUBLIC_EXPO_PROJECT_ID=your-expo-project-id

# Analytics & Monitoring
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_ENABLED=true

# Feature Flags
EXPO_PUBLIC_ENABLE_STRIPE=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_BIOMETRIC_AUTH=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true

# App Configuration
EXPO_PUBLIC_APP_NAME=FlipperAgents
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_REGION=us-east-1
EXPO_PUBLIC_MIN_API_VERSION=1
EXPO_PUBLIC_SUPPORT_EMAIL=support@flipperagents.com

# Development
EXPO_PUBLIC_LOG_LEVEL=info
EXPO_PUBLIC_ENABLE_DEV_TOOLS=true

# Asset CDN (optional)
EXPO_PUBLIC_ASSET_CDN=
