{
  "name": "@magnus-flipper-ai/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:dev:android": "eas build --profile development --platform android",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:preview:android": "eas build --profile preview --platform android",
    "eas:build:preview:ios": "eas build --profile preview --platform ios",
    "eas:build:prod": "eas build --profile production --platform all",
    "eas:build:prod:android": "eas build --profile production --platform android",
    "eas:build:prod:ios": "eas build --profile production --platform ios",
    "eas:submit:prod": "eas submit --platform all --profile production",
    "eas:submit:prod:android": "eas submit --platform android --profile production",
    "eas:submit:prod:ios": "eas submit --platform ios --profile production",
    "eas:update:preview": "eas update --branch preview --message \"Preview update\"",
    "eas:update:prod": "eas update --branch production --message \"Production update\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@expo/vector-icons": "^14.0.4",
    "@gorhom/bottom-sheet": "^4.6.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@shopify/flash-list": "1.6.4",
    "@stripe/stripe-react-native": "0.38.6",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.9",
    "axios": "^1.6.5",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "expo": "~52.0.0",
    "expo-build-properties": "^1.0.9",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.3",
    "expo-device": "~7.0.1",
    "expo-font": "~13.0.1",
    "expo-linking": "~7.0.3",
    "expo-notifications": "~0.29.12",
    "expo-router": "~4.0.9",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.4",
    "nativewind": "^4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.3.3"
  },
  "packageManager": "pnpm@9.15.4"
}
