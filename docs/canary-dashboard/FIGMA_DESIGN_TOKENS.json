{
  "$schema": "https://schemas.figma.com/v1/tokens",
  "version": "1.0.0",
  "name": "Enterprise Canary Dashboard Design Tokens",
  "description": "Complete design token system for Enterprise Canary Dashboard - Dark & Light themes",
  
  "typography": {
    "headings": {
      "h1": {
        "fontFamily": "Inter",
        "fontSize": "32px",
        "fontWeight": 700,
        "letterSpacing": "-0.5px",
        "lineHeight": "40px"
      },
      "h2": {
        "fontFamily": "Inter",
        "fontSize": "24px",
        "fontWeight": 600,
        "letterSpacing": "-0.25px",
        "lineHeight": "32px"
      },
      "h3": {
        "fontFamily": "Inter",
        "fontSize": "20px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": "28px"
      },
      "h4": {
        "fontFamily": "Inter",
        "fontSize": "18px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": "24px"
      },
      "h5": {
        "fontFamily": "Inter",
        "fontSize": "16px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": "22px"
      },
      "h6": {
        "fontFamily": "Inter",
        "fontSize": "14px",
        "fontWeight": 600,
        "letterSpacing": "0px",
        "lineHeight": "20px"
      }
    },
    "body": {
      "bodyL": {
        "fontFamily": "Inter",
        "fontSize": "16px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": "24px"
      },
      "bodyM": {
        "fontFamily": "Inter",
        "fontSize": "14px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": "20px"
      },
      "bodyS": {
        "fontFamily": "Inter",
        "fontSize": "12px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": "16px"
      }
    },
    "mono": {
      "monoL": {
        "fontFamily": "JetBrains Mono",
        "fontSize": "14px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": "20px"
      },
      "monoM": {
        "fontFamily": "JetBrains Mono",
        "fontSize": "12px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": "20px"
      },
      "monoS": {
        "fontFamily": "JetBrains Mono",
        "fontSize": "11px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": "16px"
      }
    }
  },

  "colors": {
    "dark": {
      "semantic": {
        "success": {
          "50": "#F0FDF4",
          "100": "#DCFCE7",
          "500": "#22C55E",
          "600": "#16A34A",
          "700": "#15803D"
        },
        "warning": {
          "50": "#FFFBEB",
          "100": "#FEF3C7",
          "500": "#F59E0B",
          "600": "#D97706",
          "700": "#B45309"
        },
        "danger": {
          "50": "#FEF2F2",
          "100": "#FEE2E2",
          "500": "#EF4444",
          "600": "#DC2626",
          "700": "#B91C1C"
        }
      },
      "chart": {
        "blue": "#3B82F6",
        "purple": "#A855F7",
        "orange": "#F97316",
        "green": "#22C55E",
        "red": "#EF4444",
        "yellow": "#EAB308"
      },
      "traffic": {
        "stable": "#3B82F6",
        "canary": "#A855F7",
        "split": "#6B7280"
      },
      "background": {
        "primary": "#0D1117",
        "secondary": "#161B22",
        "tertiary": "#1F2937",
        "subtle": "#0F1419",
        "hover": "#1C2128"
      },
      "border": {
        "subtle": "#21262D",
        "strong": "#30363D",
        "focus": "#58A6FF"
      },
      "text": {
        "primary": "#E6EDF3",
        "secondary": "#8B949E",
        "muted": "#6E7681",
        "inverse": "#0D1117"
      }
    },
    "light": {
      "semantic": {
        "success": {
          "500": "#22C55E"
        },
        "warning": {
          "500": "#F59E0B"
        },
        "danger": {
          "500": "#EF4444"
        }
      },
      "background": {
        "primary": "#FFFFFF",
        "secondary": "#F6F8FA",
        "tertiary": "#FFFFFF",
        "subtle": "#F6F8FA",
        "hover": "#F0F3F6"
      },
      "border": {
        "subtle": "#D1D9E0",
        "strong": "#B1BAC4",
        "focus": "#0969DA"
      },
      "text": {
        "primary": "#1F2328",
        "secondary": "#656D76",
        "muted": "#8B949E",
        "inverse": "#FFFFFF"
      }
    }
  },

  "spacing": {
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    },
    "semantic": {
      "cardPadding": "24px",
      "panelPadding": "16px",
      "cellPadding": "12px 16px",
      "badgePadding": "4px 12px",
      "chipPadding": "6px 12px",
      "logLinePadding": "4px 0px"
    }
  },

  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },

  "shadows": {
    "none": "none",
    "cardHover": "0 4px 12px rgba(0, 0, 0, 0.15)",
    "modal": "0 8px 24px rgba(0, 0, 0, 0.25)",
    "focus": "0 0 0 2px rgba(88, 166, 255, 0.3)"
  },

  "transitions": {
    "fast": "150ms ease",
    "normal": "200ms ease",
    "slow": "300ms ease"
  },

  "components": {
    "card": {
      "padding": "24px",
      "borderRadius": "8px",
      "border": "1px solid",
      "borderColor": "{colors.dark.border.subtle}",
      "background": "{colors.dark.background.secondary}",
      "shadow": "{shadows.none}",
      "hoverShadow": "{shadows.cardHover}"
    },
    "panel": {
      "padding": "16px",
      "borderRadius": "6px",
      "background": "{colors.dark.background.tertiary}",
      "border": "1px solid",
      "borderColor": "{colors.dark.border.subtle}"
    },
    "statusBadge": {
      "padding": "4px 12px",
      "borderRadius": "12px",
      "fontSize": "12px",
      "fontWeight": 600,
      "height": "24px",
      "variants": {
        "success": {
          "background": "{colors.dark.semantic.success.500}",
          "color": "{colors.dark.text.inverse}"
        },
        "warning": {
          "background": "{colors.dark.semantic.warning.500}",
          "color": "{colors.dark.text.inverse}"
        },
        "danger": {
          "background": "{colors.dark.semantic.danger.500}",
          "color": "{colors.dark.text.inverse}"
        },
        "info": {
          "background": "{colors.dark.chart.blue}",
          "color": "{colors.dark.text.inverse}"
        }
      }
    },
    "tagChip": {
      "padding": "6px 12px",
      "borderRadius": "16px",
      "fontSize": "12px",
      "fontWeight": 500,
      "background": "{colors.dark.background.tertiary}",
      "border": "1px solid",
      "borderColor": "{colors.dark.border.subtle}"
    },
    "dataTable": {
      "rowHeight": "48px",
      "cellPadding": "12px 16px",
      "headerBackground": "{colors.dark.background.subtle}",
      "rowHover": "{colors.dark.background.hover}",
      "border": "1px solid",
      "borderColor": "{colors.dark.border.subtle}"
    },
    "logLine": {
      "fontFamily": "JetBrains Mono",
      "fontSize": "12px",
      "lineHeight": "20px",
      "padding": "4px 0px",
      "background": "transparent",
      "hoverBackground": "{colors.dark.background.subtle}",
      "levelColors": {
        "info": "{colors.dark.text.secondary}",
        "warn": "{colors.dark.semantic.warning.500}",
        "error": "{colors.dark.semantic.danger.500}",
        "debug": "{colors.dark.text.muted}"
      }
    },
    "chart": {
      "palette": {
        "primary": "{colors.dark.chart.blue}",
        "secondary": "{colors.dark.chart.purple}",
        "tertiary": "{colors.dark.chart.orange}",
        "success": "{colors.dark.chart.green}",
        "danger": "{colors.dark.chart.red}"
      },
      "gridLines": "{colors.dark.border.subtle}",
      "axisLabels": "{colors.dark.text.secondary}",
      "title": {
        "fontSize": "18px",
        "fontWeight": 600,
        "color": "{colors.dark.text.primary}"
      }
    }
  },

  "layout": {
    "grid": {
      "columns": 12,
      "gutter": "24px",
      "baseline": "8px"
    },
    "breakpoints": {
      "mobile": "375px",
      "tablet": "640px",
      "desktop": "1024px",
      "large": "1440px"
    },
    "containers": {
      "topbar": {
        "height": "64px",
        "padding": "0 24px"
      },
      "sidebar": {
        "widthExpanded": "240px",
        "widthCollapsed": "64px"
      },
      "card": {
        "minHeight": "200px",
        "maxWidth": "400px"
      }
    }
  },

  "accessibility": {
    "contrast": {
      "text": {
        "minimum": "4.5:1",
        "enhanced": "7:1"
      },
      "interactive": {
        "minimum": "3:1"
      }
    },
    "focus": {
      "ringWidth": "2px",
      "ringColor": "{colors.dark.border.focus}",
      "ringOffset": "2px"
    },
    "motion": {
      "respectReducedMotion": true,
      "maxDuration": "200ms"
    }
  }
}
