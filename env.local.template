# Magnus Flipper AI - Local Development Environment Template
# Copy this file to .env.local and fill in your values
# .env.local is git-ignored and should never be committed

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Required: Get from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ============================================
# STRIPE CONFIGURATION
# ============================================
# Required: Get from Stripe Dashboard → Developers → API keys
# Use test keys for local development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE=
STRIPE_AGENCY_PRICE=

# ============================================
# APPLICATION URLS
# ============================================
# Local development URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# OPTIONAL: MONITORING & ANALYTICS
# ============================================
# Uncomment and fill if using Sentry or PostHog
# SENTRY_DSN=
# POSTHOG_KEY=

# ============================================
# OPTIONAL: WORKER / API CONFIGURATION
# ============================================
# Uncomment if running workers locally
# REDIS_URL=redis://localhost:6379
# WORKER_SECRET=
# LOG_LEVEL=info

