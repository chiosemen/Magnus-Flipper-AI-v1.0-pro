{
  "name": "magnus-flipper-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "generate": "prisma generate --schema=packages/core/prisma/schema.prisma",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:scheduler": "pnpm --filter scheduler dev",
    "dev:worker-crawler": "pnpm --filter worker-crawler dev",
    "dev:worker-analyzer": "pnpm --filter worker-analyzer dev",
    "dev:worker-alerts": "pnpm --filter worker-alerts dev",
    "start:web": "pnpm --filter web start",
    "start:api": "pnpm --filter api start",
    "start:scheduler": "pnpm --filter scheduler start",
    "start:worker-crawler": "pnpm --filter worker-crawler start",
    "start:worker-analyzer": "pnpm --filter worker-analyzer start",
    "start:worker-alerts": "pnpm --filter worker-alerts start",
    "lint": "pnpm -r lint",
    "test": "echo \"No tests present — skipping.\" && exit 0",
    "test:ci": "echo \"CI test bypass\" && exit 0",
    "test:e2e": "cypress run --config-file tests/cypress.config.ts",
    "test:e2e:open": "cypress open --config-file tests/cypress.config.ts",
    "spec:check": "ts-node scripts/validate-imports.ts",
    "deploy:check": "bash scripts/deploy-check.sh",
    "release:check": "pnpm lint && pnpm test && pnpm build",
    "release:verify": "node scripts/deploy/verify.mjs",
    "release:full": "pnpm release:check && pnpm release:verify",
    "predeploy:azure": "pnpm release:full && ./scripts/deploy/dry-run.sh",
    "launch:prep": "pnpm release:full",
    "launch:ci-hint": "echo 'After launch:prep, run Azure Dry Run, then Deploy/Promote workflows.'",
    "secrets:gate": "node scripts/deploy/secrets-integrity-gate.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "bullmq": "^5",
    "libsodium-wrappers": "^0.7.15",
    "winston": "^3",
    "zod": "^3"
  }
}
