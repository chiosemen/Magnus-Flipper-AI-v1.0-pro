{
  "name": "@magnus-flipper-ai/alerts",
  "version": "1.0.0",
  "description": "Alert eligibility rules (pure logic, no IO)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./carAlertRules": {
      "types": "./dist/carAlertRules.d.ts",
      "import": "./dist/carAlertRules.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  }
}

