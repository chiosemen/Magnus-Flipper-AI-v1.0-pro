{
  "name": "@magnus-flipper-ai/core",
  "version": "1.0.0",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tiers/tier-service": "./dist/tiers/tier-service.js",
    "./tiers/tier-config": "./dist/tiers/tier-config.js",
    "./types/feed": "./dist/types/feed.js",
    "./types/affiliate": "./dist/types/affiliate.js",
    "./services/marketplaceControlService": "./dist/services/marketplaceControlService.js",
    "./services/scrapeRunService": "./dist/services/scrapeRunService.js",
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "echo 'Skipping prisma generate inside Docker build...'",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "db:erd": "echo 'ERD generation: prisma-erd-generator incompatible with Prisma 7.x. Use dbdiagram.io with schema.prisma or SQL introspection.'",
    "postinstall": "echo 'Skipping prisma generate (temporarily patched)'"
  },
  "dependencies": {
    "@prisma/client": "7.0.1",
    "@prisma/adapter-pg": "7.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@magnus-flipper-ai/feed-engine": "workspace:*",
    "prisma": "7.0.1",
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3"
  }
}