{
  "name": "@magnus-flipper-ai/core",
  "version": "1.0.0",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js"
    },
    "./alerts/alert-service": {
      "types": "./dist/alerts/alert-service.d.ts",
      "import": "./dist/alerts/alert-service.js"
    },
    "./tiers/tier-config": {
      "types": "./dist/tiers/tier-config.d.ts",
      "import": "./dist/tiers/tier-config.js"
    },
    "./tiers/tier-service": {
      "types": "./dist/tiers/tier-service.d.ts",
      "import": "./dist/tiers/tier-service.js"
    },
    "./analytics/search-analytics": {
      "types": "./dist/analytics/search-analytics.d.ts",
      "import": "./dist/analytics/search-analytics.js"
    },
    "./contracts/feed": {
      "types": "./dist/contracts/feed.d.ts",
      "import": "./dist/contracts/feed.js"
    },
    "./types/feed": {
      "types": "./dist/types/feed.d.ts",
      "import": "./dist/types/feed.js"
    },
    "./types/affiliate": {
      "types": "./dist/types/affiliate.d.ts",
      "import": "./dist/types/affiliate.js"
    },
    "./types/compliance": {
      "types": "./dist/types/compliance.d.ts",
      "import": "./dist/types/compliance.js"
    },
    "./types/scraper": {
      "types": "./dist/types/scraper.d.ts",
      "import": "./dist/types/scraper.js"
    },
    "./services/marketplaceControlService": {
      "types": "./dist/services/marketplaceControlService.d.ts",
      "import": "./dist/services/marketplaceControlService.js"
    },
    "./services/scrapeRunService": {
      "types": "./dist/services/scrapeRunService.d.ts",
      "import": "./dist/services/scrapeRunService.js"
    },
    "./healthcheck": {
      "types": "./dist/healthcheck.d.ts",
      "import": "./dist/healthcheck.js"
    },
    "./ui-contracts": {
      "types": "./ui-contracts/index.d.ts",
      "import": "./ui-contracts/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "echo 'Skipping prisma generate inside Docker build...'",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "db:erd": "echo 'ERD generation: prisma-erd-generator incompatible with Prisma 7.x. Use dbdiagram.io with schema.prisma or SQL introspection.'",
    "postinstall": "echo 'Skipping prisma generate (temporarily patched)'"
  },
  "dependencies": {
    "@magnus-flipper-ai/compliance-shield": "workspace:*",
    "@prisma/client": "7.0.1",
    "@prisma/adapter-pg": "7.0.1",
    "@supabase/supabase-js": "^2.87.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "prisma": "7.0.1",
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3"
  }
}