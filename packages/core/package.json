{
  "name": "@magnus-flipper-ai/core",
  "version": "1.0.0",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "echo 'Skipping prisma generate inside Docker build...'",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "db:erd": "prisma generate --schema=./prisma/schema.prisma && echo 'ERD written to docs/db/erd.svg'",
    "postinstall": "echo 'Skipping prisma generate (temporarily patched)'"
  },
  "dependencies": {
    "@prisma/client": "7.0.1",
    "@prisma/adapter-pg": "7.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "prisma": "7.0.1",
    "prisma-erd-generator": "^1.11.1",
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3"
  }
}