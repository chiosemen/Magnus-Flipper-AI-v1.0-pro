// Magnus Flipper AI - Prisma Schema
// Database: PostgreSQL (Supabase)

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // Force binary engine to avoid queryEngine conversion issues in CI
  engineType    = "binary"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../../docs/db/erd.svg"
}

datasource db {
  provider = "postgresql"
}

// User model
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  savedSearches SavedSearch[]
  alerts        Alert[]

  @@map("users")
}

// Saved Search model
model SavedSearch {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  query       String
  marketplace String
  filters     Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@map("saved_searches")
  @@index([userId])
}

// Alert model
model Alert {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  savedSearchId  String?  @map("saved_search_id") @db.Uuid
  listingId      String   @map("listing_id")
  title          String
  price          Float
  marketplace    String
  url            String
  alertType      String   @map("alert_type")
  isRead         Boolean  @default(false) @map("is_read")
  isSent         Boolean  @default(false) @map("is_sent")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch   SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)

  @@map("alerts")
  @@index([userId])
  @@index([savedSearchId])
  @@index([isSent])
}

// Listing model (cached marketplace data)
model Listing {
  id          String   @id @default(uuid()) @db.Uuid
  externalId  String   @unique @map("external_id")
  marketplace String
  title       String
  description String?
  price       Float
  location    String?
  url         String
  imageUrl    String?  @map("image_url")
  metadata    Json?
  firstSeen   DateTime @default(now()) @map("first_seen") @db.Timestamptz(6)
  lastSeen    DateTime @default(now()) @map("last_seen") @db.Timestamptz(6)
  isActive    Boolean  @default(true) @map("is_active")

  @@map("listings")
  @@index([marketplace])
  @@index([externalId])
  @@index([isActive])
}

// Subscription model
model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  stripeId      String?   @unique @map("stripe_id")
  plan          String
  status        String
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("subscriptions")
  @@index([userId])
  @@index([stripeId])
}

// ScrapeRun model - tracks marketplace scraping outcomes for observability
model ScrapeRun {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Marketplace + user context
  marketplace   String
  userId        String?
  savedSearchId String?
  tier          String?

  // Outcome
  success       Boolean
  durationMs    Int?

  // Error info (if any)
  errorCode     String?
  errorMessage  String?

  @@index([marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([success, createdAt])
  @@map("scrape_runs")
}

// MarketplaceControl model - admin controls for per-marketplace behavior
model MarketplaceControl {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // marketplace identifier (e.g. "ebay", "amazon", "facebook")
  marketplace    String   @unique

  // if false: worker should NOT run scrapes for this marketplace
  enabled        Boolean  @default(true)

  // soft cap for how many jobs can be running IN PARALLEL
  // for this marketplace per worker instance
  maxConcurrency Int      @default(5)

  @@map("marketplace_controls")
}

// OperationalAlert model - system alerts generated by worker-alerts
model OperationalAlert {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Alert context
  marketplace   String
  severity      String   // "INFO" | "WARNING" | "CRITICAL"
  summary       String
  category      String   // "RATE_LIMIT" | "BLOCK" | "NETWORK" | "OTHER"
  
  // ML classification results
  mlProvider    String?  @map("ml_provider") // "openai", "deepseek", or null for heuristics
  confidence    Float?   // 0.0-1.0
  
  // Context and recommendations
  rawContext    Json?    @map("raw_context")
  recommendations String[] // Array of recommendation strings

  @@map("operational_alerts")
  @@index([marketplace, createdAt])
  @@index([severity, createdAt])
  @@index([category])
}
