{
  "name": "@magnus-flipper-ai/deal-engine",
  "version": "1.0.0",
  "description": "AI-powered deal classification and scoring engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./types/Listing": {
      "types": "./dist/types/Listing.d.ts",
      "import": "./dist/types/Listing.js"
    },
    "./types/DealScore": {
      "types": "./dist/types/DealScore.d.ts",
      "import": "./dist/types/DealScore.js"
    },
    "./scoring/baseScore": {
      "types": "./dist/scoring/baseScore.d.ts",
      "import": "./dist/scoring/baseScore.js"
    },
    "./scoring/deepseekClassifier": {
      "types": "./dist/scoring/deepseekClassifier.d.ts",
      "import": "./dist/scoring/deepseekClassifier.js"
    },
    "./scoring/openaiClassifier": {
      "types": "./dist/scoring/openaiClassifier.d.ts",
      "import": "./dist/scoring/openaiClassifier.js"
    },
    "./calibrator/calibrate": {
      "types": "./dist/calibrator/calibrate.d.ts",
      "import": "./dist/calibrator/calibrate.js"
    },
    "./calibrator/bayesian": {
      "types": "./dist/calibrator/bayesian.d.ts",
      "import": "./dist/calibrator/bayesian.js"
    },
    "./calibrator/llmConsensus": {
      "types": "./dist/calibrator/llmConsensus.d.ts",
      "import": "./dist/calibrator/llmConsensus.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepare": "pnpm run build"
  },
  "keywords": ["ai", "deals", "classification", "scoring"],
  "author": "Magnus Flipper AI",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "axios": "^1.13.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  }
}
