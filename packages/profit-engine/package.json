{
  "name": "@magnus-flipper-ai/profit-engine",
  "version": "1.0.0",
  "description": "Auto-sell detection and profit ledger tracking system",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./autosell/saleDetector": {
      "types": "./dist/autosell/saleDetector.d.ts",
      "import": "./dist/autosell/saleDetector.js"
    },
    "./autosell/finalizeSale": {
      "types": "./dist/autosell/finalizeSale.d.ts",
      "import": "./dist/autosell/finalizeSale.js"
    },
    "./autosell/crossPlatformLock": {
      "types": "./dist/autosell/crossPlatformLock.d.ts",
      "import": "./dist/autosell/crossPlatformLock.js"
    },
    "./ledger/feeModel": {
      "types": "./dist/ledger/feeModel.d.ts",
      "import": "./dist/ledger/feeModel.js"
    },
    "./ledger/profitLedger": {
      "types": "./dist/ledger/profitLedger.d.ts",
      "import": "./dist/ledger/profitLedger.js"
    },
    "./ledger/evCorrector": {
      "types": "./dist/ledger/evCorrector.d.ts",
      "import": "./dist/ledger/evCorrector.js"
    },
    "./ledger/portfolioEngine": {
      "types": "./dist/ledger/portfolioEngine.d.ts",
      "import": "./dist/ledger/portfolioEngine.js"
    },
    "./schemas/SaleEvent": {
      "types": "./dist/schemas/SaleEvent.d.ts",
      "import": "./dist/schemas/SaleEvent.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "prepare": "pnpm run build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["profit", "ledger", "analytics", "roi"],
  "author": "Magnus Flipper AI",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "axios": "^1.13.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  }
}
