{
  "name": "@magnus-flipper-ai/scraper-sync",
  "version": "1.0.0",
  "description": "Live marketplace scraper synchronization engine with deduplication",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./orchestrator/scraperOrchestrator": {
      "types": "./dist/orchestrator/scraperOrchestrator.d.ts",
      "import": "./dist/orchestrator/scraperOrchestrator.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "poll:active-searches": "node dist/scripts/pollActiveSearches.js"
  },
  "keywords": ["scraper", "sync", "deduplication", "marketplace"],
  "author": "Magnus Flipper AI",
  "license": "MIT",
  "dependencies": {
    "@magnus-flipper-ai/compliance-shield": "workspace:*",
    "@magnus-flipper-ai/core": "workspace:*",
    "@magnus-flipper-ai/marketplace-config": "workspace:*",
    "@supabase/supabase-js": "^2.86.0",
    "playwright": "^1.48.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.24.1",
    "axios": "^1.13.2",
    "cheerio": "^1.0.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  }
}
