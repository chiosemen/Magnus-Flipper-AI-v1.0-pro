{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@magnus-flipper-ai/core": ["../core/dist/index"],
      "@magnus-flipper-ai/core/*": ["../core/dist/*"],
      "@magnus-flipper-ai/marketplace-config": ["../marketplace-config/dist/index"],
      "@magnus-flipper-ai/compliance-shield": ["../compliance-shield/dist/index"],
      "@magnus-flipper-ai/compliance-shield/*": ["../compliance-shield/dist/*"],
      "@magnus-flipper-ai/scoring": ["../scoring/dist/index"],
      "@magnus-flipper-ai/scoring/*": ["../scoring/dist/*"]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
