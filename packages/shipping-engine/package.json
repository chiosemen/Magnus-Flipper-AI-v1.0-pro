{
  "name": "@magnus-flipper-ai/shipping-engine",
  "version": "1.0.0",
  "description": "Automated shipping label generation and fulfillment workflow system",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tracking/trackingManager": {
      "types": "./dist/tracking/trackingManager.d.ts",
      "import": "./dist/tracking/trackingManager.js"
    },
    "./label/labelGenerator": {
      "types": "./dist/label/labelGenerator.d.ts",
      "import": "./dist/label/labelGenerator.js"
    },
    "./schemas/ShippingRequest": {
      "types": "./dist/schemas/ShippingRequest.d.ts",
      "import": "./dist/schemas/ShippingRequest.js"
    },
    "./carrier/selectCarrier": {
      "types": "./dist/carrier/selectCarrier.d.ts",
      "import": "./dist/carrier/selectCarrier.js"
    },
    "./carrier/rateCalculator": {
      "types": "./dist/carrier/rateCalculator.d.ts",
      "import": "./dist/carrier/rateCalculator.js"
    },
    "./label/labelStorage": {
      "types": "./dist/label/labelStorage.d.ts",
      "import": "./dist/label/labelStorage.js"
    },
    "./workflow/fulfillmentOrchestrator": {
      "types": "./dist/workflow/fulfillmentOrchestrator.d.ts",
      "import": "./dist/workflow/fulfillmentOrchestrator.js"
    },
    "./workflow/packagingAdvisor": {
      "types": "./dist/workflow/packagingAdvisor.d.ts",
      "import": "./dist/workflow/packagingAdvisor.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["shipping", "fulfillment", "logistics", "labels"],
  "author": "Magnus Flipper AI",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "@supabase/storage-js": "^2.7.1",
    "axios": "^1.13.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  }
}
