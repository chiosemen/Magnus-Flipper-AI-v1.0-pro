{
  "name": "@magnus-flipper-ai/tech-trade-core",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pricing-engine": {
      "types": "./dist/pricing-engine.d.ts",
      "import": "./dist/pricing-engine.js"
    },
    "./device-catalog": {
      "types": "./dist/device-catalog.d.ts",
      "import": "./dist/device-catalog.js"
    },
    "./anchor-blending": {
      "types": "./dist/anchor-blending.d.ts",
      "import": "./dist/anchor-blending.js"
    },
    "./market-indicators": {
      "types": "./dist/market-indicators.d.ts",
      "import": "./dist/market-indicators.js"
    },
    "./policy-enforcement": {
      "types": "./dist/policy-enforcement.d.ts",
      "import": "./dist/policy-enforcement.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@magnus-flipper-ai/core": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
