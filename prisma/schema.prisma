// Magnus Flipper AI - Prisma Schema
// Database: PostgreSQL (Supabase)

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // Prisma 7 uses library engine by default (binary is deprecated)
  // engineType removed for compatibility with Prisma 7.x
}

// Temporarily disabled: prisma-erd-generator is incompatible with Prisma 7.x
// generator erd {
//   provider = "prisma-erd-generator"
//   output   = "../../docs/db/erd.svg"
// }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  savedSearches SavedSearch[]
  alerts        Alert[]

  @@map("users")
}

// Saved Search model
model SavedSearch {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  query       String
  marketplace String
  filters     Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  // Performance metrics
  lastRunAt         DateTime? @map("last_run_at") @db.Timestamptz(6)
  totalListingsScanned Int    @default(0) @map("total_listings_scanned")
  totalMatchesFound    Int    @default(0) @map("total_matches_found")
  totalRuns            Int    @default(0) @map("total_runs")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts Alert[]

  @@map("saved_searches")
  @@index([userId])
}

// Alert model
model Alert {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  savedSearchId  String?  @map("saved_search_id") @db.Uuid
  listingId      String   @map("listing_id")
  title          String
  price          Float
  marketplace    String
  url            String
  alertType      String   @map("alert_type")
  isRead         Boolean  @default(false) @map("is_read")
  isSent         Boolean  @default(false) @map("is_sent")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch   SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)

  @@map("alerts")
  @@index([userId])
  @@index([savedSearchId])
  @@index([isSent])
}

// Listing model (cached marketplace data)
model Listing {
  id          String   @id @default(uuid()) @db.Uuid
  externalId  String   @unique @map("external_id")
  marketplace String
  title       String
  description String?
  price       Float
  location    String?
  url         String
  imageUrl    String?  @map("image_url")
  metadata    Json?
  firstSeen   DateTime @default(now()) @map("first_seen") @db.Timestamptz(6)
  lastSeen    DateTime @default(now()) @map("last_seen") @db.Timestamptz(6)
  isActive    Boolean  @default(true) @map("is_active")

  // Relation to IngestRun
  ingestRunId String?  @map("ingest_run_id") @db.Uuid
  ingestRun   IngestRun? @relation(fields: [ingestRunId], references: [id], onDelete: SetNull)

  @@map("listings")
  @@index([marketplace])
  @@index([externalId])
  @@index([isActive])
  @@index([ingestRunId])
}

// Subscription model
model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  stripeId      String?   @unique @map("stripe_id")
  plan          String
  status        String
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("subscriptions")
  @@index([userId])
  @@index([stripeId])
}

// ScrapeRun model - tracks marketplace scraping outcomes for observability
model ScrapeRun {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Marketplace + user context
  marketplace   String
  userId        String?
  savedSearchId String?
  tier          String?

  // Outcome
  success       Boolean
  durationMs    Int?

  // Error info (if any)
  errorCode     String?
  errorMessage  String?

  @@index([marketplace, createdAt])
  @@index([userId, createdAt])
  @@index([success, createdAt])
  @@map("scrape_runs")
}

// MarketplaceControl model - admin controls for per-marketplace behavior
model MarketplaceControl {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // marketplace identifier (e.g. "ebay", "amazon", "facebook")
  marketplace    String   @unique

  // if false: worker should NOT run scrapes for this marketplace
  enabled        Boolean  @default(true)

  // soft cap for how many jobs can be running IN PARALLEL
  // for this marketplace per worker instance
  maxConcurrency Int      @default(5)

  @@map("marketplace_controls")
}

// OperationalAlert model - system alerts generated by worker-alerts
model OperationalAlert {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Alert context
  marketplace   String
  severity      String   // "INFO" | "WARNING" | "CRITICAL"
  summary       String
  category      String   // "RATE_LIMIT" | "BLOCK" | "NETWORK" | "OTHER"
  
  // ML classification results
  mlProvider    String?  @map("ml_provider") // "openai", "deepseek", or null for heuristics
  confidence    Float?   // 0.0-1.0
  
  // Context and recommendations
  rawContext    Json?    @map("raw_context")
  recommendations String[] // Array of recommendation strings

  @@map("operational_alerts")
  @@index([marketplace, createdAt])
  @@index([severity, createdAt])
  @@index([category])
}

// DeployGuardian Runs - persisted validation results for ops dashboard
// Contract version: 2.1.0+
model DeployGuardianRun {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Provenance
  environment String @default("production")
  mode        String // pre-deploy | deploy | post-deploy
  status      String // pass | fail

  commitSha String? @map("commit_sha")
  actor     String?
  workflow  String?
  runId     String? @unique @map("run_id")
  branch    String?

  // Contract metadata (v2.1.0+)
  contractVersion    String? @map("contract_version")
  contractSchemaHash String? @map("contract_schema_hash")

  // Summary counts (denormalized for fast filtering)
  blockers Int @default(0)
  warnings Int @default(0)
  infos    Int @default(0)

  // Complete JSON payload (single source of truth)
  payload Json

  @@map("deploy_guardian_runs")
  @@index([createdAt(sort: Desc)])
  @@index([environment, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([commitSha])
  @@index([contractVersion])
}

// IngestRun model - tracks hybrid ingestion runs with strategy, cost, and ROI
model IngestRun {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt     DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)

  // Context
  marketplace   String
  query         String
  region        String
  tier          String   // "free" | "pro" | "premium"
  traceId       String?  @map("trace_id")
  userId        String?  @map("user_id") @db.Uuid
  savedSearchId String?  @map("saved_search_id") @db.Uuid

  // Execution strategy
  strategy      IngestStrategy @default(local)
  apifyRunId    String?  @map("apify_run_id") // Apify actor run ID if used

  // Results
  listingsFetched Int     @default(0) @map("listings_fetched")
  durationSeconds Int?    @map("duration_seconds")
  errorCount      Int     @default(0) @map("error_count")

  // Cost tracking (estimated USD)
  estimatedCostUSD Float? @map("estimated_cost_usd")

  // Relations
  listings      Listing[]

  @@map("ingest_runs")
  @@index([marketplace, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([strategy, createdAt(sort: Desc)])
  @@index([tier, createdAt(sort: Desc)])
}

// DealEvent model - tracks user interactions with listings (saved, alerted, exported, purchased)
model DealEvent {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Event context
  eventType     DealEventType @map("event_type")
  userId        String   @map("user_id") @db.Uuid
  listingId     String?  @map("listing_id") @db.Uuid
  ingestRunId   String?  @map("ingest_run_id") @db.Uuid

  // Event metadata
  metadata      Json?

  @@map("deal_events")
  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([listingId])
}

// Enums
enum IngestStrategy {
  local
  apify
  hybrid
}

enum DealEventType {
  SAVED
  ALERTED
  EXPORTED
  PURCHASED
}
