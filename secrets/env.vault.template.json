{
  "$schema": "https://magnus.flipper/env-vault.schema.json",
  "version": 1,
  "environments": {
    "local": {
      "description": "Developer laptop / Cursor / local runs",
      "values": {
        "SUPABASE_URL": "https://YOUR-PROD-PROJECT.supabase.co",
        "SUPABASE_ANON_KEY": "YOUR_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY": "YOUR_SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_DB_URL": "postgresql://postgres:ENCODED_PASSWORD@db.YOUR-PROD-PROJECT.supabase.co:5432/postgres",
        "SUPABASE_STAGING_DB_URL": "postgresql://postgres:ENCODED_PASSWORD@db.YOUR-STAGING-PROJECT.supabase.co:5432/postgres",
        "DATABASE_URL": "postgresql://postgres:ENCODED_PASSWORD@db.YOUR-PROD-PROJECT.supabase.co:5432/postgres",
        "REDIS_URL": "redis://default:ENCODED_PASSWORD@YOUR_REDIS_HOST:6379",
        "STRIPE_SECRET_KEY": "sk_live_xxx",
        "STRIPE_WEBHOOK_SECRET": "whsec_xxx",
        "OPENAI_API_KEY": "sk-xxx",
        "GEMINI_API_KEY": "AIza...",
        "AZURE_SUBSCRIPTION_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_TENANT_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_CLIENT_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_CLIENT_SECRET": "your-azure-client-secret",
        "AZURE_RESOURCE_GROUP": "magnus-flipper-prod",
        "AZURE_ACR_NAME": "magnusprodregistry",
        "AZURE_CONTAINERAPPS_ENV_PROD": "magnus-env-prod",
        "AZURE_CONTAINERAPPS_ENV_STAGING": "magnus-env-staging",
        "VERCEL_TOKEN": "your-vercel-token",
        "AI_GATEWAY_API_KEY": "vck_xxx",
        "EXPO_PUBLIC_API_URL": "https://magnus-flipper-ai.onrender.com/api/v1",
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_APP_NAME": "FlipperAgents",
        "EXPO_PUBLIC_VERSION": "1.0.3",
        "EXPO_PUBLIC_REGION": "us-east-1",
        "NODE_ENV": "development",
        "APP_URL": "http://localhost:3000"
      }
    },
    "staging": {
      "description": "Cloud staging environment",
      "values": {
        "SUPABASE_URL": "https://YOUR-STAGING-PROJECT.supabase.co",
        "SUPABASE_ANON_KEY": "YOUR_STAGING_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY": "YOUR_STAGING_SERVICE_ROLE_KEY",
        "SUPABASE_DB_URL": "postgresql://postgres:ENCODED_PASSWORD@db.YOUR-STAGING-PROJECT.supabase.co:5432/postgres",
        "DATABASE_URL": "postgresql://postgres:ENCODED_PASSWORD@db.YOUR-STAGING-PROJECT.supabase.co:5432/postgres",
        "REDIS_URL": "redis://default:ENCODED_PASSWORD@YOUR-STAGING-REDIS:6379",
        "STRIPE_SECRET_KEY": "sk_test_xxx",
        "STRIPE_WEBHOOK_SECRET": "whsec_staging_xxx",
        "OPENAI_API_KEY": "sk-staging-xxx",
        "GEMINI_API_KEY": "AIza-staging-xxx",
        "AZURE_SUBSCRIPTION_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_TENANT_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_CLIENT_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_CLIENT_SECRET": "your-azure-client-secret",
        "AZURE_RESOURCE_GROUP": "magnus-flipper-staging",
        "AZURE_ACR_NAME": "magnusstagingregistry",
        "AZURE_CONTAINERAPPS_ENV_STAGING": "magnus-env-staging",
        "VERCEL_TOKEN": "your-vercel-token",
        "AI_GATEWAY_API_KEY": "vck_staging_xxx",
        "NODE_ENV": "production",
        "APP_URL": "https://staging.flipperagents.com"
      }
    },
    "production": {
      "description": "Live app hitting real marketplaces",
      "values": {
        "SUPABASE_URL": "https://YOUR-PROD-PROJECT.supabase.co",
        "SUPABASE_ANON_KEY": "YOUR_PROD_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY": "YOUR_PROD_SERVICE_ROLE_KEY",
        "SUPABASE_DB_URL": "postgresql://postgres:ENCODED_PASSWORD@db.YOUR-PROD-PROJECT.supabase.co:5432/postgres",
        "DATABASE_URL": "postgresql://postgres:ENCODED_PASSWORD@db.YOUR-PROD-PROJECT.supabase.co:5432/postgres",
        "REDIS_URL": "redis://default:ENCODED_PASSWORD@YOUR-PROD-REDIS:6379",
        "STRIPE_SECRET_KEY": "sk_live_xxx",
        "STRIPE_WEBHOOK_SECRET": "whsec_live_xxx",
        "OPENAI_API_KEY": "sk-live-xxx",
        "GEMINI_API_KEY": "AIza-live-xxx",
        "AZURE_SUBSCRIPTION_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_TENANT_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_CLIENT_ID": "xxxx-xxxx-xxxx-xxxx",
        "AZURE_CLIENT_SECRET": "your-azure-client-secret",
        "AZURE_RESOURCE_GROUP": "magnus-flipper-prod",
        "AZURE_ACR_NAME": "magnusprodregistry",
        "AZURE_CONTAINERAPPS_ENV_PROD": "magnus-env-prod",
        "VERCEL_TOKEN": "your-vercel-token",
        "AI_GATEWAY_API_KEY": "vck_prod_xxx",
        "NODE_ENV": "production",
        "APP_URL": "https://www.flipperagents.com"
      }
    }
  }
}
