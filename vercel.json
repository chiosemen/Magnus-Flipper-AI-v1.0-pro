{
  "builds": [
    {
      "src": "api/live-test.ts",
      "use": "@vercel/node@3.1.0"
    },
    {
      "src": "api/guardian.ts",
      "use": "@vercel/node@3.1.0"
    }
  ],
  "routes": [
    {
      "src": "/api/live-test",
      "dest": "api/live-test.ts"
    },
    {
      "src": "/api/guardian",
      "dest": "api/guardian.ts"
    },
    {
      "src": "/api/guardian/(.*)",
      "dest": "api/guardian.ts"
    }
  ]
}
